# Copiar a .env y completar. Ningun valor real se versiona.
# La lista completa y su significado estan en docs/operacion/configuracion.md
#
# Los valores de este archivo sirven para desarrollo en localhost tal como
# estan: copiarlo a .env deja el backend y el frontend arrancables sin tocar
# nada. Ninguno sirve fuera de localhost.

SPRING_PROFILES_ACTIVE=local

# --- Base de datos ----------------------------------------------------------

DB_URL=jdbc:postgresql://localhost:5432/sastra
DB_USERNAME=sastra
DB_PASSWORD=sastra

# Opcional: el backend escucha en 8080 si no se define.
SERVER_PORT=8080

# --- Sesiones y tokens ------------------------------------------------------

JWT_ISSUER=http://localhost:8080
JWT_SECRET=generar-una-clave-de-256-bits-como-minimo
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P30D

# Ventana de gracia de RN-007 (ADR-0014). Se mide en segundos: cubre una carrera
# entre dos pestanas, no una sesion. En PT0S vuelve el comportamiento anterior a
# la ADR, con sus falsos avisos de incidente.
JWT_REFRESH_GRACE=PT10S

SESSION_COOKIE_NAME=sastra_refresh
SESSION_COOKIE_PATH=/api/v1/auth
# En la nube, nunca false. Aqui lo esta para poder probar desde el movil contra
# el portatil sin montar TLS.
SESSION_COOKIE_SECURE=false

# --- Direcciones y zona -----------------------------------------------------

APP_BASE_URL=http://localhost:4200
APP_API_BASE_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:4200
SUPPORT_EMAIL=soporte@localhost

# RN-008 compara fechas de calendario, no instantes: con UTC alguien en Colombia
# cumpliria 18 anos cinco horas antes de que aqui sea su cumpleanos.
APP_TIME_ZONE=America/Bogota

# --- Limites de tasa --------------------------------------------------------
#
# RN-006 protege una cuenta; esto protege el endpoint. CREDENTIALS cubre ingreso,
# registro, verificacion y recuperacion; SESSION cubre refresco y cierre, que los
# dispara el navegador solo y se repiten mas.

RATE_LIMIT_CREDENTIALS_MAX=10
RATE_LIMIT_CREDENTIALS_WINDOW=PT1M
RATE_LIMIT_SESSION_MAX=60
RATE_LIMIT_SESSION_WINDOW=PT1M
RATE_LIMIT_MAX_KEYS=50000

# --- Correo -----------------------------------------------------------------
#
# console imprime el enlace de verificacion en el registro de la aplicacion, que
# es lo que permite recorrer HU-001 entera sin credenciales. En dev y prod se usa
# resend (ADR-0012): imprimir un token de un solo uso es imprimir una credencial.

MAIL_PROVIDER=console
MAIL_FROM=hola@sastra.co
# MAIL_PROVIDER_API_KEY=
MAIL_API_URL=https://api.resend.com/emails

# Rutas del frontend que reciben cada enlace. Se concatenan a APP_BASE_URL y las
# conoce tambien la tabla de rutas de Angular: si cambian alli, cambian aqui.
MAIL_VERIFICATION_PATH=/verificar-correo
MAIL_PASSWORD_RESET_PATH=/restablecer-contrasena
MAIL_EMAIL_CHANGE_PATH=/confirmar-correo-nuevo

# --- Documentos legales -----------------------------------------------------
#
# Obligatorias en el backend, que las guarda como prueba del consentimiento. Las
# tres tienen que valer lo mismo en backend y frontend: si no, se muestra un texto
# distinto del que quedo escrito y la prueba deja de valer.
#
# borrador-local son los textos de relleno de frontend/public/legal, sin valor
# legal. El procedimiento para publicar un texto nuevo esta en
# docs/operacion/textos-legales.md.

LEGAL_TERMS_VERSION=borrador-local
LEGAL_PRIVACY_VERSION=borrador-local
# Solo del frontend: nadie consiente cookies en un formulario.
LEGAL_COOKIES_VERSION=borrador-local

# --- Contrasenas filtradas (ADR-0013) ---------------------------------------
#
# Se apaga en las pruebas de extremo a extremo y en desarrollo sin red. El minimo
# de diez caracteres de RN-005 se sigue comprobando siempre: esa regla vive en el
# dominio y no depende de nadie.

PASSWORD_BREACH_CHECK_ENABLED=true
PASSWORD_BREACH_CHECK_TIMEOUT=PT2S
PASSWORD_BREACH_API_URL=https://api.pwnedpasswords.com/range

# --- Cifras de negocio ------------------------------------------------------
#
# Las anuncia el sitio informativo y en Colombia lo anunciado es exigible, asi
# que no pueden vivir en una plantilla ni en un archivo de traduccion. Las lee el
# backend y tambien el frontend, que las escribe en las paginas.
#
# COMMISSION_RATE es una fraccion: 0.05 es el 5% (RN-026). Un 5 se anunciaria
# como 500% y un 0 como que no se cobra nada; el servidor no arranca con ninguno.
COMMISSION_RATE=0.05
# Dias habiles desde la entrega para reportar (RN-051). Hoy la lee solo el
# frontend; en el backend entra con los pedidos, en Fase 3.
CLAIM_WINDOW_DAYS=3

# --- Datos de la empresa ----------------------------------------------------
#
# Son configuracion porque la figura juridica puede cambiar; el NIT real no va
# aqui. Las lee el backend y tambien el pie del sitio: es la misma empresa.

COMPANY_NAME=Sastra
COMPANY_TAX_ID=000000000-0
COMPANY_ADDRESS=Medellin, Colombia

# --- Frontend ---------------------------------------------------------------
#
# Las lee el servidor de renderizado y viajan al navegador dentro del HTML. No se
# compilan en el paquete: el mismo artefacto sirve para dev y para prod.

API_BASE_URL=http://localhost:8080/api/v1

# Obligatoria: sin ella el servidor de renderizado no levanta. Es la lista de
# dominios a los que acepta responder y protege contra falsificacion de
# peticiones del lado del servidor. Si faltara, Angular no fallaria: entregaria
# la pagina sin renderizar, que es justo lo que ADR-0006 existe para impedir.
NG_ALLOWED_HOSTS=localhost

DEFAULT_LOCALE=es
AVAILABLE_LOCALES=es,en
PORT=4000

# Opcional. Vacia deja el informe de errores apagado.
SENTRY_DSN=
# false en produccion.
ENABLE_DEVTOOLS=true

# --- Banderas de funcionalidad ----------------------------------------------
#
# Todas apagadas en Fase 1: permiten desplegar codigo incompleto sin exponerlo.

FEATURE_SELLER_VERIFICATION=false
FEATURE_PUBLISHING=false
FEATURE_CHECKOUT=false
FEATURE_SEARCH=false
FEATURE_SPIN_VIEWER=false

# --- Solo para docker compose -----------------------------------------------
#
# No las lee la aplicacion: crean la base de datos del contenedor. El backend se
# conecta por DB_URL, asi que si cambias DB_PORT hay que cambiar tambien el
# puerto dentro de DB_URL.

DB_NAME=sastra
DB_PORT=5432

# --- Fase 2: almacenamiento de imagenes -------------------------------------
#
# Todavia no las lee ninguna clase: el almacenamiento entra con la publicacion
# de prendas (docs/producto/alcance.md).

STORAGE_BUCKET=sastra-media-local
STORAGE_SIGNED_URL_TTL=PT10M

# --- Fase 3: busqueda con Typesense -----------------------------------------

TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_API_KEY=

# --- Fase 3: pagos con Wompi ------------------------------------------------

WOMPI_BASE_URL=https://sandbox.wompi.co/v1
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_SECRET=

# --- Cloud Storage
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./archivos-locales
STORAGE_PUBLIC_BASE_URL=http://localhost:8080/archivos
# Cloud Run no acepta peticiones de mas de 32MB, asi que subirlo por encima no
# sirve de nada. 8MB sobra para una imagen 3:4 ya recortada en el cliente.
STORAGE_MAX_IMAGE_BYTES=8388608
# Minimo de la FOTO DE PERFIL, no de las tomas de producto. RN-019 fija 900x1200
# para esas (HU-003) y aplicarselo al avatar rechazaria casi cualquier foto que
# alguien tenga a mano. Nadie ha decidido un minimo para el avatar: esto es un
# valor de arranque, no una regla de negocio.
STORAGE_AVATAR_MIN_WIDTH=200
STORAGE_AVATAR_MIN_HEIGHT=200