{
  "version": "0.2.0",
  "configurations": [
    {
      // Levanta el servidor de desarrollo y abre Chrome con el depurador
      // enganchado. Los puntos de interrupcion en el .ts funcionan directamente.
      "name": "Servidor de desarrollo",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "npm: start",
      "url": "http://localhost:4200/",
      "webRoot": "${workspaceFolder}"
    },
    {
      // Vitest corre en Node, no en el navegador: se depura con node-terminal.
      // La configuracion que genera el CLI apunta a Karma en el 9876, que este
      // proyecto no usa (ver frontend/CLAUDE.md).
      "name": "Pruebas",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm test",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Pruebas de extremo a extremo",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run e2e",
      "cwd": "${workspaceFolder}"
    }
  ]
}
