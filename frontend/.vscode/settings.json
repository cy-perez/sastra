{
  // El formato lo fija .prettierrc y lo verifica `npm run lint`. Guardar con
  // formato evita que la verificacion falle por comillas o saltos de linea.
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "eslint.validate": ["javascript", "typescript", "html"],

  // La version de TypeScript es la del proyecto, no la que trae VS Code.
  "typescript.tsdk": "node_modules/typescript/lib",

  "files.exclude": {
    "**/.angular": true,
    "**/dist": true,
    "**/coverage": true,
    "**/test-results": true
  }
}
